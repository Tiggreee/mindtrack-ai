# Base de datos (Neon free, Supabase o Postgres local + pgvector)
DATABASE_URL="postgresql://user:password@localhost:5432/mindtrack?schema=public"

# NextAuth
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# LLM — ollama (gratis, local) es el default
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Opcional en la nube (Groq tiene tier gratis)
# LLM_PROVIDER="groq"
# GROQ_API_KEY=""

# Opcional calidad (de pago)
# LLM_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""

# Embeddings — ollama local o openai
EMBEDDING_PROVIDER="ollama"
OLLAMA_EMBED_MODEL="nomic-embed-text"
# EMBEDDING_PROVIDER="openai"
# OPENAI_API_KEY=""

# Fase 3 — Google Calendar
# GOOGLE_CALENDAR_CLIENT_ID=""
# GOOGLE_CALENDAR_CLIENT_SECRET=""
